# Activar solo una URL según el servidor donde se publicará

# Servidor de pruebas
VITE_API_BASE_URL=http://IP_SERVIDOR_PRUEBAS:PUERTO

# Servidor de producción
# VITE_API_BASE_URL=http://IP_SERVIDOR_PRODUCCION:PUERTO

VITE_USE_MOCKS=false
VITE_USE_DOCUMENTOS_MOCK=true

# Analytics API independiente
# Desarrollo: Vite puede proxyear /analytics-api al backend local.
VITE_ANALYTICS_API_BASE_URL=/analytics-api
VITE_ANALYTICS_API_PROXY_TARGET=http://localhost:5080
VITE_ANALYTICS_USE_MOCKS=false
