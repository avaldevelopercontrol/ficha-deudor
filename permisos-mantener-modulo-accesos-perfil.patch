diff --git a/src/features/seguridad/modules/mantener-accesos-perfil/utils/mantenerAccesosPerfilPermissions.test.ts b/src/features/seguridad/modules/mantener-accesos-perfil/utils/mantenerAccesosPerfilPermissions.test.ts
